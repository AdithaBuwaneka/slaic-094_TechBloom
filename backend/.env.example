# Application Settings
APP_NAME=Transit Companion Backend
DEBUG=true
API_V1_STR=/api/v1

# MongoDB Configuration
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_CONNECTION_STRING=mongodb+srv://username:password@cluster.mongodb.net/
DATABASE_NAME=transit_companion_db

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# CORS Settings
BACKEND_CORS_ORIGINS=["*"]

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

GROQ_API_KEY=your_groq_api_key_here

GOOGLE_API_KEY=your_google_api_key_here

SERPER_API_KEY=your_serper_api_key_here

# Optional: Additional API keys for enhanced functionality
OPENWEATHER_API_KEY=your_openweather_api_key_here

DEBUG=True
LOG_LEVEL=INFO
MAX_ROUTES_PER_REQUEST=5
DEFAULT_SEARCH_RADIUS_KM=50

LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here

GOOGLE_APPLICATION_CREDENTIALS="googleAppCredentials.json"

EXPO_PUBLIC_BACKEND_URL="http://10.0.2.2:8000"
