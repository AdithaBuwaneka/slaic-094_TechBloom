# =============================================================================
# Transit Companion Mobile App - Environment Configuration
# =============================================================================
# Copy this file to .env and configure your settings

# Backend API Configuration
# --------------------------
# Default: 10.0.2.2 (Android Emulator localhost)
# For iOS Simulator: use localhost or 127.0.0.1
# For physical device: use your computer's local network IP (e.g., 192.168.1.100)
# For Expo Go on physical device: use your computer's local network IP
EXPO_PUBLIC_API_HOST=10.0.2.2

# Backend API Port
EXPO_PUBLIC_API_PORT=8000

# API Protocol (http or https)
EXPO_PUBLIC_API_PROTOCOL=http

# Production Backend URL (optional, only for production builds)
# EXPO_PUBLIC_PRODUCTION_API_URL=https://your-production-domain.com

# WebSocket Configuration
# ------------------------
# WebSocket Protocol (ws or wss)
EXPO_PUBLIC_WS_PROTOCOL=ws

# Common IP addresses for development:
# - 10.0.2.2         → Android Emulator (points to host machine's localhost)
# - localhost        → iOS Simulator / Web
# - 192.168.x.x      → Physical device on same WiFi network
# - Your computer IP → Find with: ifconfig (Mac/Linux) or ipconfig (Windows)
